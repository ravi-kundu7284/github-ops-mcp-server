# GitHub Configuration
# Generate a Personal Access Token (PAT) at https://github.com/settings/tokens
# Required scopes: repo, read:org, workflow (or fine-grained token with repository read/write and actions read/write)
GITHUB_TOKEN=ghp_your_github_token_here
GITHUB_API_URL=https://api.github.com

# Server Configuration
APP_HOST=0.0.0.0
APP_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security & CORS
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Optional Backend API Key for authenticating client calls to FastAPI
# If set, clients must pass X-API-Key or Authorization: Bearer <API_KEY>
API_KEY=

# MCP Configuration
MCP_SERVER_NAME=github-ops-mcp-server
MCP_SERVER_VERSION=1.0.0

# Audit Logging (maximum operations kept in memory)
MAX_AUDIT_LOGS=500
